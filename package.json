{
  "name": "dsh-web-search-tavily",
  "version": "0.1.1",
  "description": "Tavily-backed WebSearchProvider for the DeepSeek Harness web seam (ctx.web) - keyless mode supported, no API key required",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "web-search",
    "tavily",
    "search",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnChenKai/dsh-web-search-tavily.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^1.0.0"
  }
}
