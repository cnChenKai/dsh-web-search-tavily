{
  "name": "dsh-web-search-tavily",
  "version": "0.2.5",
  "description": "Tavily-backed WebSearchProvider for the DeepSeek Harness web seam (ctx.web) - keyless mode supported, no API key required",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "web-search",
    "tavily",
    "search",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnChenKai/dsh-web-search-tavily.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-web": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.1",
    "vitest": "^4.1.12"
  }
}
